<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>[%highlight(%-5level)] %cyan(%logger) - %msg %n</pattern>
    </encoder>
  </appender>

  <logger name="lucuma-odb" level="INFO" />
  <logger name="lucuma-odb-container" level="DEBUG" />
  <logger name="lucuma-odb-test" level="ERROR" />
  <logger name="pdf-summary-service" level="INFO"/>
  <logger name="pdf-summary-jobs" level="INFO"/>
  <!-- DEBUG here surfaces pyexplore's own stderr for each render. -->
  <logger name="pdf-summary-renderer" level="DEBUG"/>

  <!-- Log slow queries -->
  <logger name="lucuma-odb-slow-query" level="WARN"/>

  <root level="INFO">
    <appender-ref ref="STDOUT" />
  </root>

</configuration>
