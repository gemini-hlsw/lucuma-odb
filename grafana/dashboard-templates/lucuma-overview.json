{
 "apiVersion": "dashboard.grafana.app/v1beta1",
 "kind": "Dashboard",
 "metadata": {
  "name": "lucuma-overview",
  "namespace": "stacks-1577729",
  "annotations": {
   "grafana.app/folder": "lucuma-health"
  }
 },
 "spec": {
  "title": "GPP Status Overview",
  "uid": "lucuma-overview",
  "tags": [
   "lucuma",
   "health",
   "status"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "editable": false,
  "graphTooltip": 0,
  "time": {
   "from": "now-13d/d",
   "to": "now"
  },
  "refresh": "15m",
  "timepicker": {
   "hidden": true
  },
  "description": "Current status and 14 days of daily availability for the GPP services, workers and database.",
  "links": [
   {
    "title": "What the checks mean",
    "type": "link",
    "url": "https://github.com/gemini-hlsw/lucuma-odb/blob/main/ODB-README.md#health-endpoints",
    "targetBlank": true
   }
  ],
  "templating": {
   "list": [
    {
     "name": "env",
     "type": "constant",
     "hide": 2,
     "query": "dev"
    }
   ]
  },
  "annotations": {
   "list": []
  },
  "panels": [
   {
    "id": 1,
    "type": "stat",
    "title": "Components",
    "description": "Components by current state. Services and workers are Operational or Offline; the database is Degraded above 80% of its usable connections.",
    "gridPos": {
     "x": 0,
     "y": 0,
     "w": 24,
     "h": 4
    },
    "datasource": {
     "type": "prometheus",
     "uid": "grafanacloud-prom"
    },
    "targets": [
     {
      "refId": "A",
      "datasource": {
       "type": "prometheus",
       "uid": "grafanacloud-prom"
      },
      "instant": true,
      "range": false,
      "legendFormat": "Operational",
      "expr": "count(((2 * max by (system) (last_over_time(probe_success{kind=\"readiness\", environment=\"$env\"}[40m]))) or (2 * (time() - max by (service) (lucuma_worker_last_iteration_epoch_seconds{deployment_environment_name=\"$env\"}) < bool 300)) or (2 - (sum(max by (application_name) (lucuma_db_connections_used{deployment_environment_name=\"$env\"})) / max(lucuma_db_connections_max{deployment_environment_name=\"$env\"}) > bool 0.8))) == 2) or vector(0)"
     },
     {
      "refId": "B",
      "datasource": {
       "type": "prometheus",
       "uid": "grafanacloud-prom"
      },
      "instant": true,
      "range": false,
      "legendFormat": "Degraded",
      "expr": "count(((2 * max by (system) (last_over_time(probe_success{kind=\"readiness\", environment=\"$env\"}[40m]))) or (2 * (time() - max by (service) (lucuma_worker_last_iteration_epoch_seconds{deployment_environment_name=\"$env\"}) < bool 300)) or (2 - (sum(max by (application_name) (lucuma_db_connections_used{deployment_environment_name=\"$env\"})) / max(lucuma_db_connections_max{deployment_environment_name=\"$env\"}) > bool 0.8))) == 1) or vector(0)"
     },
     {
      "refId": "C",
      "datasource": {
       "type": "prometheus",
       "uid": "grafanacloud-prom"
      },
      "instant": true,
      "range": false,
      "legendFormat": "Offline",
      "expr": "count(((2 * max by (system) (last_over_time(probe_success{kind=\"readiness\", environment=\"$env\"}[40m]))) or (2 * (time() - max by (service) (lucuma_worker_last_iteration_epoch_seconds{deployment_environment_name=\"$env\"}) < bool 300)) or (2 - (sum(max by (application_name) (lucuma_db_connections_used{deployment_environment_name=\"$env\"})) / max(lucuma_db_connections_max{deployment_environment_name=\"$env\"}) > bool 0.8))) == 0) or vector(0)"
     }
    ],
    "options": {
     "reduceOptions": {
      "calcs": [
       "lastNotNull"
      ],
      "fields": "",
      "values": false
     },
     "orientation": "vertical",
     "textMode": "value_and_name",
     "colorMode": "value",
     "graphMode": "none",
     "justifyMode": "center"
    },
    "fieldConfig": {
     "defaults": {
      "decimals": 0,
      "color": {
       "mode": "fixed",
       "fixedColor": "text"
      }
     },
     "overrides": [
      {
       "matcher": {
        "id": "byFrameRefID",
        "options": "A"
       },
       "properties": [
        {
         "id": "color",
         "value": {
          "mode": "fixed",
          "fixedColor": "green"
         }
        }
       ]
      },
      {
       "matcher": {
        "id": "byFrameRefID",
        "options": "B"
       },
       "properties": [
        {
         "id": "color",
         "value": {
          "mode": "fixed",
          "fixedColor": "orange"
         }
        }
       ]
      },
      {
       "matcher": {
        "id": "byFrameRefID",
        "options": "C"
       },
       "properties": [
        {
         "id": "color",
         "value": {
          "mode": "fixed",
          "fixedColor": "red"
         }
        }
       ]
      }
     ]
    }
   },
   {
    "id": 2,
    "type": "row",
    "title": "Services",
    "collapsed": false,
    "panels": [],
    "gridPos": {
     "x": 0,
     "y": 4,
     "w": 24,
     "h": 1
