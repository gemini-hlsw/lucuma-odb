    "title": "Now",
    "description": "Operational when every probe got HTTP 200 and status ok from GET /health/ready within the last 40 minutes.",
    "gridPos": {
     "x": 0,
     "y": 5,
     "w": 6,
     "h": 6
    },
    "datasource": {
     "type": "prometheus",
     "uid": "grafanacloud-prom"
    },
    "targets": [
     {
      "refId": "A",
      "datasource": {
       "type": "prometheus",
       "uid": "grafanacloud-prom"
      },
      "instant": true,
      "range": false,
      "legendFormat": "{{system}}",
      "expr": "2 * max by (system) (last_over_time(probe_success{kind=\"readiness\", environment=\"$env\"}[40m]))"
     }
    ],
    "options": {
     "reduceOptions": {
      "calcs": [
       "lastNotNull"
      ],
      "fields": "",
      "values": false
     },
     "orientation": "horizontal",
     "textMode": "value_and_name",
     "colorMode": "value",
     "graphMode": "none",
     "justifyMode": "auto"
    },
    "fieldConfig": {
     "defaults": {
      "mappings": [
       {
        "type": "value",
        "options": {
         "0": {
          "text": "Offline",
          "color": "red",
          "index": 0
         },
         "1": {
          "text": "Degraded",
          "color": "orange",
          "index": 1
         },
         "2": {
          "text": "Operational",
          "color": "green",
          "index": 2
         }
        }
       }
      ],
      "noValue": "No data"
     },
     "overrides": []
    }
   },
   {
    "id": 4,
    "type": "status-history",
    "title": "Daily availability",
    "description": "Share of readiness probes that succeeded each UTC day. Green is 99.9% or better, orange 90% or better, red below.",
    "gridPos": {
     "x": 6,
     "y": 5,
     "w": 18,
     "h": 6
    },
    "interval": "1d",
    "maxDataPoints": 16,
    "datasource": {
     "type": "prometheus",
     "uid": "grafanacloud-prom"
    },
    "targets": [
     {
      "refId": "A",
      "datasource": {
       "type": "prometheus",
       "uid": "grafanacloud-prom"
      },
      "interval": "1d",
      "legendFormat": "{{system}}",
      "expr": "avg by (system) (avg_over_time(probe_success{kind=\"readiness\", environment=\"$env\"}[1d] offset -1d))"
     }
    ],
    "options": {
     "showValue": "never",
     "rowHeight": 0.8,
     "colWidth": 0.85,
     "legend": {
      "displayMode": "list",
      "placement": "bottom",
      "showLegend": false
     },
     "tooltip": {
      "mode": "single"
     }
    },
    "fieldConfig": {
     "defaults": {
      "unit": "percentunit",
      "decimals": 1,
      "color": {
       "mode": "thresholds"
      },
      "thresholds": {
       "mode": "absolute",
       "steps": [
        {
         "color": "red",
         "value": null
        },
        {
         "color": "orange",
         "value": 0.9
        },
        {
         "color": "green",
         "value": 0.999
        }
       ]
      }
     },
     "overrides": []
